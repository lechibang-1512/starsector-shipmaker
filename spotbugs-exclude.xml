<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Ignore calling overridable methods in constructors (Common in Swing initUI methods) -->
    <Match>
        <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR" />
    </Match>

    <!-- Ignore non-serializable fields in serializable classes (Swing classes are trivially serializable but we don't serialize them) -->
    <Match>
        <Bug pattern="SE_BAD_FIELD" />
    </Match>
    <Match>
        <Bug pattern="SE_BAD_FIELD_STORE" />
    </Match>
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID" />
    </Match>

    <!-- Ignore unconfirmed cast in our specific layer hierarchy where we know the type -->
    <Match>
        <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE" />
    </Match>

    <!-- System.exit is used intentionally in our relaunch/exit code -->
    <Match>
        <Bug pattern="DM_EXIT" />
    </Match>

    <!-- Returning null vs zero-length array has different Jackson serialization semantics -->
    <Match>
        <Bug pattern="PZLA_PREFER_ZERO_LENGTH_ARRAYS" />
    </Match>

    <!-- Expose internal representation -->
    <Match><Bug pattern="EI_EXPOSE_REP" /></Match>
    <Match><Bug pattern="EI_EXPOSE_REP2" /></Match>
    <Match><Bug pattern="EI_EXPOSE_STATIC_REP2" /></Match>
    <Match><Bug pattern="MS_EXPOSE_REP" /></Match>

    <!-- Swing uninitialized fields in constructor -->
    <Match><Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR" /></Match>

    <!-- Dead local store often false positive with temporary image buffers -->
    <Match><Bug pattern="DLS_DEAD_LOCAL_STORE" /></Match>
    
    <Match><Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE" /></Match>

    <Match><Bug pattern="BC_VACUOUS_INSTANCEOF" /></Match>
    <Match><Bug pattern="NM_CONFUSING" /></Match>
    <Match><Bug pattern="CT_CONSTRUCTOR_THROW" /></Match>
    <Match><Bug pattern="UPM_UNCALLED_PRIVATE_METHOD" /></Match>

    <!-- Global suppressions make local suppressions 'useless', which is expected -->
    <Match><Bug pattern="US_USELESS_SUPPRESSION_ON_CLASS" /></Match>
    <Match><Bug pattern="US_USELESS_SUPPRESSION" /></Match>

    <!-- Increasing accessibility is intentional when exposing protected library methods -->
    <Match><Bug pattern="IAOM_DO_NOT_INCREASE_METHOD_ACCESSIBILITY" /></Match>

    <!-- Redundant interfaces and declaring runtime exceptions in throws clause are pedantic -->
    <Match><Bug pattern="RI_REDUNDANT_INTERFACES" /></Match>
    <Match><Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" /></Match>

    <!-- Jackson serialization requires public non-private constructors on DTO singletons -->
    <Match><Bug pattern="SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR" /></Match>
    <Match><Bug pattern="SING_SINGLETON_GETTER_NOT_SYNCHRONIZED" /></Match>
    <Match><Bug pattern="SING_SINGLETON_IMPLEMENTS_SERIALIZABLE" /></Match>

    <!-- Sometimes we want to catch generic Exceptions (e.g. Swing Event thread boundaries) -->
    <Match><Bug pattern="REC_CATCH_EXCEPTION" /></Match>

    <!-- Useless control flow often flags empty Swing init methods or debug blocks -->
    <Match><Bug pattern="UCF_USELESS_CONTROL_FLOW" /></Match>

    <!-- Lazy init static is fine for our non-thread-critical caches -->
    <Match><Bug pattern="LI_LAZY_INIT_STATIC" /></Match>
</FindBugsFilter>
